#!/usr/bin/env python3
import fnmatch
import math
import re
import subprocess
import sys

MAX_TOKENS = 5000
BYTES_PER_TOKEN = 4
MAX_BYTES = MAX_TOKENS * BYTES_PER_TOKEN
TARGET_TOKENS_PER_PART = 3500

LOCKFILE_NAMES = {
    "package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml",
    "bun.lock", "bun.lockb", "deno.lock", "Cargo.lock", "poetry.lock", "uv.lock",
    "Pipfile.lock", "pdm.lock", "Gemfile.lock", "composer.lock", "go.sum", "go.work.sum",
    "flake.lock", "Package.resolved", "Podfile.lock", "mix.lock", "pubspec.lock",
    "packages.lock.json", "gradle.lockfile", "conan.lock", "MODULE.bazel.lock",
}

GENERATED_PATTERNS = (
    "*.min.js", "*.min.css", "*.min.mjs", "*.map", "*.snap", "*.lock",
    "*.svg", "*.jsonl", "*.ndjson", "*.csv", "*.tsv", "*.har",
    "*.generated.*", "*.gen.*", "*_generated.*", "*.g.dart", "*.freezed.dart",
    "*.pb.go", "*_pb2.py", "*_pb2.pyi", "*_pb2_grpc.py", "*_pb.js", "*_pb.d.ts",
    "*.pb.ts", "*.pb.swift", "*.designer.cs", "*.xcodeproj/project.pbxproj",
    "*/__generated__/*", "*/__snapshots__/*", "*/meta/*_snapshot.json", "*/meta/_journal.json",
)

GENERATED_MARKER = re.compile(
    rb"@generated\b|\bDO NOT EDIT\b|\bauto-?generated\b|\bautomatically generated\b|\bgenerated by\b",
    re.IGNORECASE,
)
HEADER_BYTES = 1024
BINARY_SNIFF_BYTES = 8000
REGULAR_FILE_MODES = {"100644", "100755"}


def git(*args, stdin=None):
    return subprocess.run(
        ["git", *args], input=stdin, capture_output=True, check=True
    ).stdout


def staged_blobs():
    out = git("diff", "--cached", "--raw", "--no-abbrev", "--no-renames",
              "--diff-filter=AM", "-z")
    fields = out.decode().split("\0")
    blobs = {}
    for meta, path in zip(fields[0::2], fields[1::2]):
        _old_mode, mode, _old_sha, sha, _status = meta.lstrip(":").split()
        if mode in REGULAR_FILE_MODES:
            blobs[path] = sha
    return blobs


def blob_sizes(shas):
    out = git("cat-file", "--batch-check=%(objectname) %(objectsize)",
              stdin="\n".join(shas).encode())
    sizes = {}
    for line in out.decode().splitlines():
        sha, size = line.split()
        sizes[sha] = int(size)
    return sizes


def marked_not_authored(paths):
    out = git("check-attr", "--cached", "--stdin", "-z",
              "linguist-generated", "linguist-vendored",
              stdin="\0".join(paths).encode())
    fields = out.decode().split("\0")
    triples = zip(fields[0::3], fields[1::3], fields[2::3])
    return {path for path, _attr, value in triples if value in ("set", "true")}


def generated_by_name(path):
    name = path.rsplit("/", 1)[-1]
    return name in LOCKFILE_NAMES or any(
        fnmatch.fnmatchcase("/" + path if "/" in pattern else name, pattern)
        for pattern in GENERATED_PATTERNS)


def generated_or_binary_by_content(sha):
    head = git("cat-file", "blob", sha)[:BINARY_SNIFF_BYTES]
    return b"\0" in head or bool(GENERATED_MARKER.search(head[:HEADER_BYTES]))


def merged_parents():
    probe = subprocess.run(["git", "rev-parse", "-q", "--verify", "MERGE_HEAD"],
                           capture_output=True)
    if probe.returncode != 0:
        return []
    path = git("rev-parse", "--git-path", "MERGE_HEAD").decode().strip()
    with open(path) as handle:
        return [line.strip() for line in handle if line.strip()]


def blobs_carried_from(parents, paths):
    carried = {}
    for parent in parents:
        out = git("ls-tree", "-r", "-z", parent, "--", *paths)
        for entry in out.decode().split("\0"):
            if entry:
                meta, path = entry.split("\t", 1)
                carried.setdefault(path, set()).add(meta.split()[2])
    return carried


def oversized_files():
    blobs = staged_blobs()
    if not blobs:
        return []
    sizes = blob_sizes(set(blobs.values()))
    candidates = [p for p, sha in blobs.items()
                  if sizes[sha] > MAX_BYTES and not generated_by_name(p)]
    parents = merged_parents()
    if candidates and parents:
        carried = blobs_carried_from(parents, candidates)
        candidates = [p for p in candidates if blobs[p] not in carried.get(p, set())]
    if not candidates:
        return []
    not_authored = marked_not_authored(candidates)
    return [(p, sizes[blobs[p]]) for p in candidates
            if p not in not_authored and not generated_or_binary_by_content(blobs[p])]


def report(files):
    lines = [
        f"pre-commit: {len(files)} staged file(s) exceed {MAX_TOKENS:,} tokens "
        f"(tokens = bytes / {BYTES_PER_TOKEN}, limit {MAX_BYTES:,} bytes).",
        "",
    ]
    for path, size in sorted(files):
        tokens = math.ceil(size / BYTES_PER_TOKEN)
        parts = math.ceil(tokens / TARGET_TOKENS_PER_PART)
        lines.append(f"  {path}: ~{tokens:,} tokens ({size:,} bytes) "
                     f"-> split into at least {parts} files")
    lines += [
        "",
        "How to split each file:",
        f"  1. Aim for parts of about {TARGET_TOKENS_PER_PART:,} tokens "
        f"({TARGET_TOKENS_PER_PART * BYTES_PER_TOKEN:,} bytes), so the next",
        "     edit does not push one straight back over the limit.",
        "  2. Cut along responsibilities, not line counts. List what the file does,",
        "     group the functions, types and constants each job needs, and give",
        "     every group its own file, named for that job. A part named utils,",
        "     helpers, misc, part2 or common means the cut is in the wrong place.",
        "  3. Source code: move each group into a sibling module next to the",
        "     original, and keep the original only as the entry point that other",
        "     code already imports. Update every import site (grep for the moved",
        "     names) instead of re-exporting everything through a barrel file.",
        "     Shared private helpers go with their main caller; extract a shared",
        "     module only when two parts both need them.",
        "  4. Tests: split by the behaviour under test, one file per unit or",
        "     feature, mirroring the source split. Move shared setup and fixtures",
        "     into a fixtures/helpers file the test files import.",
        "  5. Markdown and docs: split at the top-level headings into a folder of",
        "     files, one subject each, and keep the original as a short index",
        "     that links to every part.",
        "  6. Data and config (JSON, YAML, fixtures): split by top-level key or by",
        "     record group into separate files, and load or merge them where the",
        "     single file was read.",
        "  7. Re-run the type check, linter and tests, then stage the new files",
        "     and the shrunk original together and commit again.",
        "",
        "Do not shrink a file by deleting comments or whitespace, minifying it,",
        "or joining lines: that hides the size, it does not split the file.",
        "",
        "A file a tool writes (lockfile, codegen, snapshot, minified bundle) is",
        "skipped by this check. If this one is generated or third-party,",
        "mark it in .gitattributes instead of splitting it:",
        "    path/to/file linguist-generated=true",
        "    vendor/dir/** linguist-vendored=true",
    ]
    print("\n".join(lines), file=sys.stderr)


def main():
    files = oversized_files()
    if files:
        report(files)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
