#!/usr/bin/env bash
# Copy the yann plugin's domain-canon hook into a repo whose teammates don't run the plugin.
# usage: vendor-domain-canon <repo> [--check]   (--check: exit 1 when the repo's copy has drifted)
set -euo pipefail
src="$(cd "$(dirname "$0")/../plugins/yann/hooks" && pwd)/domain-canon.py"
repo="${1:?usage: vendor-domain-canon <repo> [--check]}"
dest="$repo/.agents/hooks/domain-canon.py"
if [[ "${2:-}" == "--check" ]]; then
  cmp -s "$src" "$dest" || { echo "drift: $dest"; exit 1; }
  [[ ! -e "$repo/.agents/hooks/domain_canon" ]] || { echo "extra: $repo/.agents/hooks/domain_canon"; exit 1; }
  exit 0
fi
cp "$src" "$dest"
[[ ! -e "$repo/.agents/hooks/domain_canon" ]] || git -C "$repo" rm -q -r "$repo/.agents/hooks/domain_canon"
echo "vendored $dest"
